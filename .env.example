PRAVO_BASE_URL=https://dela.pravo.tech
PRAVO_LOGIN=your_email@example.com
PRAVO_PASSWORD=your_password

# LEADERTASK_BASE_URL=https://web.leadertask.com
# LEADERTASK_LOGIN=your_email@example.com
# LEADERTASK_PASSWORD=your_password
# LEADERTASK_ENABLED=true — включает шаг пуша новых заседаний в LeaderTask в основном sync (по умолчанию выключено, чтобы не флапать историю)
LEADERTASK_ENABLED=false

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=grand_pravo

WEB_USERNAME=admin
WEB_PASSWORD=change-me
SESSION_SECRET=replace-with-long-random-string
# WEB_SESSION_SECURE=true — включить secure-cookie (требует HTTPS, для прода)
WEB_SESSION_SECURE=false

# DB_CLEAR_BEFORE_SYNC=true очищает все таблицы перед прогоном (events, sessions, cases, checks)
DB_CLEAR_BEFORE_SYNC=false
