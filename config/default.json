{
  "pravo": {
    "loginPath": "/ms/Account/v3/JSONLogOn",
    "profilePath": "/api/Account/Profile",
    "listGroupsPath": "/ms/UserData/Folder/ListGroups",
    "folderCasesPath": "/ms/UserData/Folder/Cases",
    "caseEventsPath": "/ms/CaseCard/api/v1/Event/List",
    "iWillGoPath": "/ms/UserData/CaseSessions/IWillGo",
    "requestTimeoutMs": 30000,
    "debug": true,
    "defaultHeaders": {
      "X-Requested-With": "XMLHttpRequest"
    }
  },
  "leadertask": {
    "baseUrl": "https://web.leadertask.com",
    "apiPrefix": "/api/v1",
    "authPath": "/users/authjson",
    "refreshPath": "/tokens/refresh",
    "existsPath": "/users/exists",
    "accountInfoPath": "/account/info",
    "accountExitPath": "/account/exit",
    "accountRightsPath": "/account/rights",
    "navigatorInfoPath": "/navigator/info",
    "taskPath": "/task",
    "tagPath": "/tag",
    "system": "web",
    "typeDevice": "web",
    "enabled": false,
    "autoTagName": "Авто",
    "autoTagColor": "#A020F0",
    "caseUrlPattern": "https://dela.pravo.tech/card/case/{caseId}",
    "requestTimeoutMs": 30000,
    "debug": true,
    "defaultHeaders": {
      "Accept": "application/json"
    }
  },
  "db": {
    "dialect": "mysql",
    "syncAlter": true,
    "pool": {
      "max": 5,
      "min": 0,
      "acquire": 30000,
      "idle": 10000
    }
  },
  "web": {
    "session": {
      "cookieName": "grand_pravo.sid",
      "maxAgeMs": 86400000,
      "secure": false
    }
  }
}
